# Local development. Keep real keys in .env or your host's secret settings.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Ollama is the default for local use; the app auto-detects configured cloud providers.
DEFAULT_PROVIDER=ollama
DATA_DIR=./data
APP_BASE_URL=http://localhost:3000

# Add at least one provider key for cloud AI. API usage is billed by that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Optional in-site architectural image studio. Keep this secret on the server.
KREA_API_KEY=
KREA_IMAGE_CREDIT_COST=5

# Optional Ollama endpoint reachable by this server. Use a vision model for image uploads.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Gmail confirmation. Use an App Password (not the normal Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# Free allowance per verified account; resets daily at 00:00 UTC.
AI_DAILY_CREDITS=15
IMAGE_CREDIT_COST=5
